# Copy to .env and fill in real values. `docker compose` reads this file
# automatically. Never commit the real .env.

# ---- Bybit credentials (consolidator + strategy workers) ------------------
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_DEMO=1
DEFAULT_EXCHANGE=bybit_demo

# ---- Webapp -------------------------------------------------------------
# No WEBAPP_PORT — webapp isn't published to the host directly, only
# oauth2-proxy is (see below). That's the actual public entry point.
#
# API_TOKEN is a secondary, app-level check on the deploy admin endpoints
# (/api/deploy/*) — belt-and-suspenders on top of oauth2-proxy, which is
# the real gate. Endpoints 503 if this is unset. Pick something long and
# random: `openssl rand -hex 32`. Sent as `Authorization: Bearer <token>`.
API_TOKEN=

# ---- oauth2-proxy (gates /internal* and /api/deploy* on GitHub org login) --
# The public entry point — cloudflared/your reverse proxy should point at
# this port, not webapp's.
OAUTH2_PROXY_PORT=4180
PUBLIC_HOSTNAME=qrfzurich.com
GITHUB_ORG=ETH-Quant-Research-Group
# From the GitHub OAuth App (github.com/organizations/<org>/settings/applications).
# Callback URL on that app must be: https://<PUBLIC_HOSTNAME>/oauth2/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Generate with: openssl rand -base64 32 | head -c 32; echo
OAUTH2_PROXY_COOKIE_SECRET=

# ---- Manager ----------------------------------------------------------------
# Comma-separated list of strategy class names to keep running. The manager
# container reconciles this against the strategy-* services and starts only
# these (docker compose service names are lowercase-hyphenated versions,
# see docker-compose.yml).
ACTIVE_STRATEGIES=ExampleStrategy

# Image reference prefix allowed through POST /api/deploy — blocks pulling
# and running arbitrary public images from the webapp's deploy feature.
ALLOWED_IMAGE_PREFIX=ghcr.io/eth-quant-research-group/
